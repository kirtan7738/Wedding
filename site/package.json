{
  "name": "princy-parth-invite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/copy-benchmarks.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:tz": "cross-env TZ=America/New_York vitest run src/lib/time.test.js && cross-env TZ=Asia/Kolkata vitest run src/lib/time.test.js",
    "assets:ornaments": "node scripts/ornaments.mjs",
    "assets:images": "node scripts/images.mjs",
    "assets:og": "node scripts/og.mjs",
    "assets:qr": "node scripts/qr.mjs",
    "budget": "node scripts/budget.mjs",
    "check": "npm test && npm run test:tz && npm run build && node scripts/budget.mjs && npm run e2e"
  },
  "dependencies": {
    "@fontsource/baloo-bhai-2": "^5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/farsan": "^5.3.0",
    "@fontsource/hind-vadodara": "5.3.0",
    "@fontsource/kumar-one": "^5.3.0",
    "@fontsource/mogra": "^5.3.0",
    "@fontsource/noto-serif-gujarati": "5.3.0",
    "@fontsource/rasa": "5.3.1",
    "@fontsource/shrikhand": "^5.3.0",
    "@gsap/react": "2.1.2",
    "canvas-confetti": "1.9.4",
    "detect-gpu": "5.0.70",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "harfbuzzjs": "1.6.4",
    "jsdom": "31.0.0",
    "jsqr": "^1.4.0",
    "lil-gui": "0.21.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "stats-gl": "4.2.3",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
